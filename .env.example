# ============================================================
# data-agent 环境变量模板（可提交到仓库，不含任何真实密钥）
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，绝不会进入版本库
# ============================================================

# LLM 提供方 API Key（当前默认接入阿里云百炼 / DashScope 的 OpenAI 兼容接口）
# 百炼控制台：https://bailian.console.aliyun.com/
# 注意：必须设置，否则服务启动时 LLM 客户端会拒绝初始化
DATA_AGENT_LLM_API_KEY=

# （可选）覆盖配置文件路径，便于多环境部署，例如：
# DATA_AGENT_CONFIG=conf/app_config.prod.yaml
